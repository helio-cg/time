{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "racha-times",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "racha-times-db",
      "database_id": "198c51f1-fcf2-4dad-ae9c-d0b639b49369"
    }
  ],
  "observability": {
    "enabled": true
  }
}
